# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL
DATABASE_URL=postgresql://sabu:sabu@localhost:5433/sabu
PGHOST=localhost
PGPORT=5433
PGUSER=sabu
PGPASSWORD=sabu
PGDATABASE=sabu

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_PREFIX=v1
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Return OTP in API response — only honored when NODE_ENV !== production
AUTH_DEV_RETURN_OTP=true
# Comma-separated E.164 phones allowed to sign in to admin (hard allowlist)
AUTH_ADMIN_PHONE_ALLOWLIST=+251911129726,+14045101204
NODE_ENV=development

# Chapa (required in production for live payments / webhooks)
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# CHAPA_WEBHOOK_URL=
# CHAPA_BASE_URL=https://api.chapa.co/v1

# Apps
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
PUBLIC_WEB_URL=http://localhost:3000
WEB_PORT=3000
ADMIN_PORT=3002

# WhatsApp (Meta Cloud API) — used for Ethiopia (+251) login OTPs + order notify.
# WHATSAPP_MODE=auto|cloud|wa_me
WHATSAPP_MODE=auto
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved Meta OTP/auth template (recommended for login codes outside 24h window)
# WHATSAPP_OTP_TEMPLATE_NAME=sabu_login_otp
# WHATSAPP_OTP_TEMPLATE_LANG=en

# Twilio — used for US (+1) login OTPs
# Trial accounts cannot send free-form SMS; use Verify (recommended):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx  (Twilio Console → Verify → Services)
# Optional Content template instead of Verify (upgraded / content API):
# TWILIO_CONTENT_SID=HXxxxxxxxx
# OTP_BRAND_NAME=Sabu

# Object storage (placeholder)
S3_ENDPOINT=
S3_BUCKET=sabu
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=af-south-1

# Local media uploads (product photos / AI enhance outputs)
MEDIA_ROOT=

# AI product photo enhancement (Photoroom)
# Without a key: local white-canvas enhance keeps YOUR photo (light bg cleanup).
# With PHOTOROOM_API_KEY: true AI background removal for ecommerce cutouts.
STUDIO_ENHANCE_PROVIDER=auto
PHOTOROOM_API_KEY=
# Optional override (default: https://image-api.photoroom.com/v2/edit)
# PHOTOROOM_EDIT_URL=
