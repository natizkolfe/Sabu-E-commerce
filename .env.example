# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL
DATABASE_URL=postgresql://sabu:sabu@localhost:5433/sabu
PGHOST=localhost
PGPORT=5433
PGUSER=sabu
PGPASSWORD=sabu
PGDATABASE=sabu

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_PREFIX=v1
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Return OTP in API response (also enabled when NODE_ENV !== production)
AUTH_DEV_RETURN_OTP=true
NODE_ENV=development

# Apps
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
PUBLIC_WEB_URL=http://localhost:3000
WEB_PORT=3000
ADMIN_PORT=3002

# WhatsApp (Meta Cloud API). Leave blank to use wa.me deep-link fallback.
# WHATSAPP_MODE=auto|cloud|wa_me
WHATSAPP_MODE=auto
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Object storage (placeholder)
S3_ENDPOINT=
S3_BUCKET=sabu
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=af-south-1
